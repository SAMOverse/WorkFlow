# Supabase project settings -- Project Settings > API in the Supabase dashboard.
# Safe to expose to the browser (VITE_ prefix) -- Row-Level Security is what
# actually protects data, not keeping this key secret.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxx

# Only needed if a Netlify Function ever needs to bypass Row-Level Security
# (admin-only operations). Never expose this one to the browser.
# SUPABASE_SERVICE_ROLE_KEY=xxxx
